#!/usr/bin/env bash
# Start the Airline Booking System in dev mode (H2 in-memory database)
# Requires Java 17. If multiple JDKs installed, auto-detects Java 17.

cd "$(dirname "$0")"

# Auto-detect Java 17 on macOS
if [ -z "$JAVA_HOME" ] || ! "$JAVA_HOME/bin/java" -version 2>&1 | grep -q '"17'; then
    if [ -x /usr/libexec/java_home ]; then
        JDK17=$(/usr/libexec/java_home -v 17 2>/dev/null)
        if [ -n "$JDK17" ]; then
            export JAVA_HOME="$JDK17"
            echo "Using Java 17: $JAVA_HOME"
        fi
    elif [ -d "/opt/homebrew/opt/openjdk@17" ]; then
        export JAVA_HOME="/opt/homebrew/opt/openjdk@17"
        echo "Using Java 17: $JAVA_HOME"
    elif [ -d "/usr/local/opt/openjdk@17" ]; then
        export JAVA_HOME="/usr/local/opt/openjdk@17"
        echo "Using Java 17: $JAVA_HOME"
    fi
fi

./mvnw spring-boot:run -Dspring-boot.run.profiles=dev
